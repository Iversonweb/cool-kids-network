{
    "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "color": {
            "defaultPalette": false,
            "palette": [
                { 
                    "slug": "ckn-white", 
                    "color": "rgb(255 255 255)", 
                    "name": "Cool Kids White" 
                },
                { 
                    "slug": "ckn-gray-100", 
                    "color": "rgb(243 244 246)", 
                    "name": "Cool Kids Gray 100" 
                },
                { 
                    "slug": "ckn-gray-200", 
                    "color": "rgb(229 231 235)", 
                    "name": "Cool Kids Gray 200" 
                },
                { 
                    "slug": "ckn-gray-300", 
                    "color": "rgb(209 213 219)", 
                    "name": "Cool Kids Gray 300" 
                },
                { 
                    "slug": "ckn-gray-400", 
                    "color": "rgb(156 163 175)", 
                    "name": "Cool Kids Gray 400" 
                },
                { 
                    "slug": "ckn-gray-500", 
                    "color": "rgb(107 114 128)", 
                    "name": "Cool Kids Gray 500" 
                },
                { 
                    "slug": "ckn-gray-600", 
                    "color": "rgb(75 85 99)", 
                    "name": "Cool Kids Gray 600" 
                },
                { 
                    "slug": "ckn-gray-700", 
                    "color": "rgb(55 65 81)", 
                    "name": "Cool Kids Gray 700" 
                },
                { 
                    "slug": "ckn-gray-800",
                    "color": "rgb(31 41 55)", 
                    "name": "Cool Kids Gray 800" 
                },
                { 
                    "slug": "ckn-gray-900", 
                    "color": "rgb(21 25 33)", 
                    "name": "Cool Kids Gray 900" 
                },
                { 
                    "slug": "ckn-primary", 
                    "color": "rgb(239 68 68)", 
                    "name": "Cool Kids Primary" 
                },
                { 
                    "slug": "ckn-accent", 
                    "color": "rgb(67 56 202)", 
                    "name": "Cool Kids Accent" 
                },
                { 
                    "slug": "ckn-success", 
                    "color": "rgb(52 211 153)", 
                    "name": "Cool Kids Success" 
                },
                { 
                    "slug": "ckn-info", 
                    "color": "rgb(96 165 250)", 
                    "name": "Cool Kids Info" 
                },
                { 
                    "slug": "ckn-warning", 
                    "color": "rgb(254 210 57)", 
                    "name": "Cool Kids Warning" 
                },
                { 
                    "slug": "ckn-danger", 
                    "color": "rgb(236 72 153)", 
                    "name": "Cool Kids Danger" 
                }
            ],
            "background": true,
            "text": true,
            "link": false,
            "custom": true,
            "duotone": [
                {
                    "slug": "ckn-pink-sunset",
                    "colors": ["#11245e", "#dc4379"],
                    "name": "Cool Kids Pink Sunset"
                }
            ],
            "gradients": [
                {
                    "slug": "ckn-summer-dog",
                    "name": "Cool Kids Summer Dog",
                    "gradient": "linear-gradient(#a8ff78, #78ffd6)"
                }
            ]
        },
        "blocks": {
            "core/site-title": {
                "color": {
                    "defaultPalette": true,
                    "link": true,
                    "custom": true,
                    "gradients": [],
                    "customGradient": false
                },
                "typography": {
                    "fontFamilies": [
                        { 
                            "fontFamily": "Pacifico sans-serif",
                            "slug": "ckn-pacifico",
                            "name": "Cool Kids Pacifico"
                        }
                    ]
                }
            },
            "core/cover": {
                "color": {
                    "duotone": [],
                    "customDuotone": false
                }
            },
            "core/preformatted": {
                "typography": {
                    "fontSizes": [],
                    "customFontSize": false
                }
            }
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "typography": {
            "fontFamilies": [
                { 
                    "fontFamily": "Rubik sans-serif",
                    "slug": "ckn-rubik",
                    "name": "Cool Kids Rubik"
                },
                { 
                    "fontFamily": "Montserrat sans-serif",
                    "slug": "ckn-montserrat",
                    "name": "Cool Kids Monserrat"
                },
                { 
                    "fontFamily": "Kanit sans-serif",
                    "slug": "ckn-kanit",
                    "name": "Cool Kids Kanit"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.75rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "1.25rem",
                    "name": "Medium"
                },
                {
                    "slug": "large",
                    "size": "2.25rem",
                    "name": "Large"
                },
                {
                    "slug": "x-large",
                    "size": "3rem",
                    "name": "Extra Large"
                },
                {
                    "slug": "gigantic",
                    "size": "3.75rem",
                    "name": "Gigantic"
                }
            ],
            "lineHeight": true,
            "dropCap": true,
            "fontWeight": true,
            "fontStyle": true,
            "textTransform": true,
            "letterSpacing": true,
            "textDecoration": true
        },
        "layout": {
            "contentSize": "1000px",
            "wideSize": "1100px"
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "units": [
                "px", "rem", "vh", "vw", "%"
            ],
            "blockGap": true
        }
    },
    "styles": {
        "color": {
            "text": "var(--wp--preset--color--ckn-gray-700)",
            "background": "var(--wp--preset--color--ckn-white)"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--ckn-primary)"
                }
            }
        },
        "blocks": {
            "core/button": {
                "color": {
                    "gradient": "var(--wp--preset--color--ckn-warning)"
                }
            },
            "core/pullquote": {
                "border": {
                    "width": "2px",
                    "radius": "10px",
                    "style": "solid",
                    "color": "var(--wp--preset--color--ckn-primary)"
                } 
            },
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--ckn-pacifico)"
                }
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--ckn-montserrat)",
            "fontSize": "16px",
            "fontStyle": "normal",
            "fontWeight": "normal",
            "lineHeight": "inherit",
            "textDecoration": "none",
            "textTransform": "none"
        },
        "spacing": {
            "margin": {
                "top": "0px",
                "bottom": "0px",
                "right": "0px",
                "left": "0px"
            },
            "padding": {
                "top": "0px",
                "bottom": "0px",
                "right": "0px",
                "left": "0px"
            },
            "blockGap": "4rem"
        }
    }
}